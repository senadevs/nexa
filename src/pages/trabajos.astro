---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="Trabajo — Nexa" description="Una selección del trabajo de Nexa: marcas, campañas, webs y contenido que dejan huella.">
  <header class="site-header"><a class="brand-logo-link" href="/" aria-label="Nexa Digital Agency, inicio"><img class="brand-logo" src="/nexa-logo.svg" alt="Nexa Digital Agency" /></a><nav aria-label="Navegación principal"><a href="/#clientes">Clientes</a><a href="/#servicios">Servicios</a><a href="/trabajos" aria-current="page">Trabajo</a><a href="/#contacto">Contactos</a></nav><div class="header-actions"><a class="language-switch" href="/en/trabajos/" lang="en" onclick="localStorage.setItem('nexa-language', 'en')">EN</a><a class="header-cta" href="/#contacto">Hablemos <span>↗</span></a></div><button class="menu-toggle" type="button" aria-expanded="false" aria-label="Abrir menú"><span></span></button><nav class="mobile-menu" aria-label="Navegación móvil"><a href="/#clientes">Clientes</a><a href="/#servicios">Servicios</a><a href="/trabajos" aria-current="page">Trabajo</a><a href="/#contacto">Hablemos</a></nav></header>
  <main class="work-page"><section class="work-hero"><p class="work-hero-eyebrow">Portfolio Nexa — 2024/2026</p><h1>Hacemos<br /><em>que pase.</em></h1><div class="work-hero-bottom"><p>Identidad, estrategia y experiencias digitales pensadas para transformar atención en una relación real con la marca.</p><a href="#proyectos">Explorar proyectos ↓</a></div></section><section class="project-grid" id="proyectos" aria-label="Proyectos seleccionados"><article class="project project-large"><img class="project-image" src="/images/marea-case.png" alt="Dirección de arte del proyecto Marea" /><h2>Marea</h2><p>Una identidad con pulso para una marca que quería cambiar de ritmo.</p></article><article class="project"><img class="project-image" src="/images/norte-case.png" alt="Dirección de arte del proyecto Norte" /><h2>Norte</h2><p>Una nueva forma de mirar lo cotidiano.</p></article><article class="project"><img class="project-image" src="/images/orbita-case.png" alt="Dirección de arte de la campaña Orbita" /><h2>Orbita</h2><p>Campaña que puso la conversación en movimiento.</p></article><article class="project project-video"><img class="project-image" src="/images/studio-case.png" alt="Dirección de arte para producción audiovisual" /><div><span>Producción audiovisual</span><b>↗</b></div></article></section><section class="work-end"><p class="section-label">¿Hacemos el siguiente?</p><a href="/#contacto">Cuéntanos tu idea <span>↗</span></a></section></main>
  <footer><div class="footer-main"><a class="brand-logo-link" href="/" aria-label="Nexa Digital Agency, inicio"><img class="brand-logo brand-logo-footer" src="/nexa-logo.svg" alt="Nexa Digital Agency" /></a><p>Marketing con intención.<br />Estrategia, identidad y movimiento.</p><a class="footer-mail" href="mailto:hola@nexa.agency">hola@nexa.agency ↗</a></div><div class="footer-bottom"><nav aria-label="Navegación del pie"><a href="/#clientes">Clientes</a><a href="/#servicios">Servicios</a><a href="/trabajos">Trabajo</a><a href="/#contacto">Contactos</a></nav><span>Madrid / España</span><span>© Nexa 2026</span></div></footer>
</BaseLayout>
