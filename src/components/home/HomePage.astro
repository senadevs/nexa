---
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import { homeCopy, site, type Lang } from '../../i18n/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = homeCopy[lang];
const s = site[lang];
const pad = (n: number) => String(n).padStart(2, '0');
const clientLogos = [
  { name: 'marea', style: 'sans' },
  { name: 'norte', style: 'serif' },
  { name: 'ORBITA', style: 'wide' },
  { name: lang === 'es' ? 'estudio 44' : 'studio 44', style: 'serif italic' },
  { name: 'croma', style: 'sans dot' },
  { name: 'lumen', style: 'serif' },
];
const manifestoWords = t.manifesto.text.split(' ');
---

<SiteHeader lang={lang} surface="dark" />

<main id="main">
  <section class="hero" id="home" aria-labelledby="hero-title">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-inner">
      <h1 class="hero-title" id="hero-title">
        <span class="line"><span class="line-inner">{t.hero.lineOne}</span></span>
        <span class="line">
          <span class="line-inner rotator" aria-hidden="true">
            {t.hero.words.map((word, index) => <span class:list={['rotator-word', { 'is-active': index === 0 }]}>{word}</span>)}
          </span>
          <span class="sr-only">{t.hero.words[0]}</span>
        </span>
      </h1>
      <div class="hero-bottom">
        <p class="lead hero-lead">{t.hero.lead}</p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href={`#${s.anchors.contact}`}>{t.hero.primary}<span class="btn-icon" aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost btn-lg" href={`#${s.anchors.work}`}>{t.hero.secondary}</a>
        </div>
      </div>
    </div>
  </section>

  <div class="marquee" aria-label={t.marquee.join(', ')}>
    <div class="marquee-band marquee-band-orange">
      <div class="marquee-track" data-marquee="1">
        {[0, 1].map((copy) => (
          <div class="marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
            {t.marquee.map((item) => (
              <span class="marquee-item">
                {item}
                <svg class="marquee-star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0l2.6 8.4L23 6l-6.2 6L23 18l-8.4-2.4L12 24l-2.6-8.4L1 18l6.2-6L1 6l8.4 2.4z" /></svg>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
    <div class="marquee-band marquee-band-ink" aria-hidden="true">
      <div class="marquee-track" data-marquee="-1">
        {[0, 1].map(() => (
          <div class="marquee-group">
            {t.marquee.map((item) => (
              <span class="marquee-item marquee-item-outline">
                {item}
                <svg class="marquee-star" viewBox="0 0 24 24"><path d="M12 0l2.6 8.4L23 6l-6.2 6L23 18l-8.4-2.4L12 24l-2.6-8.4L1 18l6.2-6L1 6l8.4 2.4z" /></svg>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <section class="section manifesto" id="nosotros" aria-labelledby="manifesto-title">
    <div class="container">
      <h2 class="manifesto-text" id="manifesto-title" data-manifesto>
        {manifestoWords.map((word) => <span class:list={['mw', { 'is-accent': t.manifesto.highlights.includes(word) }]}>{word} </span>)}
      </h2>
      <div class="manifesto-foot">
        <ul class="stats" role="list">
          {t.manifesto.stats.map((stat) => (
            <li class="stat">
              <strong class="stat-value"><span data-count={stat.value}>{stat.value}</span>{stat.suffix}</strong>
              <span class="stat-label">{stat.label}</span>
            </li>
          ))}
        </ul>
        <a class="btn btn-outline" href={`#${s.anchors.process}`}>{t.manifesto.link}<span class="btn-icon" aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section class="section clients" id={s.anchors.clients} aria-labelledby="clients-title">
    <div class="container">
      <div class="split-title">
        <h2 class="display-title" id="clients-title" data-reveal-title>{t.clients.title} <em>{t.clients.titleAccent}</em></h2>
        <p class="aside">{t.clients.aside}</p>
      </div>
      <ul class="client-wall" role="list">
        {clientLogos.map((logo) => (
          <li class:list={['client-logo', logo.style]}>
            <span>{logo.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section services sheet sheet-ink" id={s.anchors.services} aria-labelledby="services-title">
    <div class="container">
      <div class="split-title">
        <h2 class="display-title" id="services-title" data-reveal-title>{t.services.title} <em>{t.services.titleAccent}</em></h2>
        <p class="aside">{t.services.aside}</p>
      </div>
      <div class="service-stack">
        {t.services.items.map((item, index) => (
          <article class="service-card" data-tone={item.tone} style={`--i:${index}`} aria-labelledby={`service-${index}`}>
            <div class="service-card-inner">
              <div class="service-top">
                <span class="service-number">{pad(index + 1)}</span>
                <ul class="tags" role="list" aria-label={item.title}>
                  {item.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
              <h3 class="service-title" id={`service-${index}`}>{item.title}</h3>
              <div class="service-body">
                <div class="service-copy">
                  <p>{item.text}</p>
                  <a class="text-link" href={`#${s.anchors.contact}`}>{t.services.cta}<span aria-hidden="true">↗</span></a>
                </div>
                <figure class="service-media">
                  <img src={item.image} alt={item.alt} width="1200" height="900" loading="lazy" decoding="async" />
                </figure>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section work sheet sheet-paper" id={s.anchors.work} aria-labelledby="work-title">
    <div class="work-pin">
      <div class="container work-header">
        <div class="split-title">
          <h2 class="display-title" id="work-title" data-reveal-title>{t.work.title} <em>{t.work.titleAccent}</em></h2>
          <div class="work-intro">
            <p class="aside">{t.work.intro}</p>
            <a class="text-link" href={s.workPage}>{t.work.all}<span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
      <div class="work-viewport">
        <ul class="work-track" role="list">
          {t.work.items.map((item, index) => (
            <li class="work-item">
              <a class="work-card" href={s.workPage} data-cursor={t.work.cursor}>
                <figure class="work-media">
                  <img src={item.image} alt={item.alt} width="1600" height="1100" loading="lazy" decoding="async" />
                </figure>
                <div class="work-info">
                  <span class="work-category">{item.category}</span>
                  <h3 class="work-name">{item.name}</h3>
                  <p>{item.result}</p>
                </div>
              </a>
            </li>
          ))}
          <li class="work-item">
            <a class="work-card work-card-next" href={`#${s.anchors.contact}`}>
              <strong class="work-next-title">{t.work.next.title}<br /><em>{t.work.next.accent}</em></strong>
              <span class="btn btn-dark btn-lg">{t.work.next.cta}<span class="btn-icon" aria-hidden="true">↗</span></span>
            </a>
          </li>
        </ul>
        <div class="work-progress" aria-hidden="true"><span></span></div>
      </div>
    </div>
  </section>

  <section class="section process immersive-break sheet sheet-ink" id={s.anchors.process} aria-labelledby="process-title">
    <h2 class="sr-only" id="process-title">{t.process.label}</h2>
    <div class="process-grid">
      <div class="immersive-copy">
        {t.process.steps.map((step, index) => (
          <article class:list={['immersive-step', { 'is-active': index === 0 }]}>
            <span class="step-number">{pad(index + 1)}</span>
            <h3>{step.title}<br /><em>{step.accent}</em></h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
      <div class="immersive-stage">
        <img class="immersive-fallback" src="/images/branding-v2.png" alt="" width="1200" height="900" loading="lazy" />
        <canvas id="scroll-canvas" aria-label={t.process.canvas}></canvas>
      </div>
    </div>
  </section>

  <section class="section contact sheet sheet-orange" id={s.anchors.contact} aria-labelledby="contact-title">
    <div class="container">
      <h2 class="contact-title" id="contact-title" data-reveal-title>{t.contact.title} <em>{t.contact.titleAccent}</em></h2>
      <div class="contact-grid">
        <div class="contact-aside">
          <p class="lead">{t.contact.intro}</p>
          <ul class="contact-channels" role="list">
            {t.contact.channels.map((channel) => (
              <li>
                <small>{channel.label}</small>
                {channel.href ? (
                  <a href={channel.href} target={channel.href.startsWith('http') ? '_blank' : undefined} rel={channel.href.startsWith('http') ? 'noreferrer' : undefined}>
                    {channel.value} <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span>{channel.value}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
        <form class="contact-form" id="contact-form" data-subject={t.contact.form.subject} data-sent={t.contact.form.sent}>
          <div class="form-field">
            <label for="name">{t.contact.form.name}</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="form-field">
            <label for="email">{t.contact.form.email}</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="form-field">
            <label for="company">{t.contact.form.company}</label>
            <input id="company" name="company" type="text" autocomplete="organization" />
          </div>
          <div class="form-field">
            <label for="service">{t.contact.form.service}</label>
            <select id="service" name="service">
              <option value="">{t.contact.form.servicePlaceholder}</option>
              {t.contact.form.services.map((service) => <option>{service}</option>)}
            </select>
          </div>
          <div class="form-field form-field-wide">
            <label for="message">{t.contact.form.message}</label>
            <textarea id="message" name="message" rows="4" required></textarea>
          </div>
          <div class="form-actions">
            <button class="btn btn-primary btn-lg" type="submit">{t.contact.form.submit}<span class="btn-icon" aria-hidden="true">↗</span></button>
            <p class="form-note" id="form-note" aria-live="polite">{t.contact.form.note}</p>
          </div>
        </form>
      </div>
    </div>
  </section>
</main>

<SiteFooter lang={lang} />

<div class="cursor-follower" aria-hidden="true"><span></span></div>

<script>
  import '../../scripts/scroll-scene';
  import '../../scripts/home-motion';

  document.querySelector<HTMLFormElement>('#contact-form')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const data = new FormData(form);
    const subject = `${form.dataset.subject} — ${data.get('company') || data.get('name')}`;
    const body = [`Nombre / Name: ${data.get('name')}`, `Email: ${data.get('email')}`, `Empresa / Company: ${data.get('company') || '—'}`, `Servicio / Service: ${data.get('service') || '—'}`, '', `${data.get('message')}`].join('\n');
    window.location.href = `mailto:hola@nexa.agency?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    const note = document.querySelector<HTMLElement>('#form-note');
    if (note && form.dataset.sent) note.textContent = form.dataset.sent;
  });
</script>
