---
import NexaLogo from '../components/NexaLogo.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: 'es' | 'en';
  ogImage?: string;
}

const {
  title = 'Nexa — Agencia de marketing digital',
  description = 'Estrategia, diseño y contenido para marcas que quieren avanzar.',
  lang = 'es',
  ogImage = '/images/og-nexa.jpg',
} = Astro.props;
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url).toString();
const ogAlt = lang === 'en' ? 'Nexa Digital Agency: orange fabric flowing over dark sculptural shapes' : 'Nexa Digital Agency: tela naranja en movimiento sobre formas escultóricas oscuras';
const knowsAbout =
  lang === 'en'
    ? ['Branding', 'Digital marketing', 'Web design', 'Paid media', 'Film production']
    : ['Branding', 'Marketing digital', 'Diseño web', 'Paid media', 'Producción audiovisual'];
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();
const basePath = Astro.url.pathname.startsWith('/en') ? Astro.url.pathname.replace(/^\/en/, '') || '/' : Astro.url.pathname;
const spanishUrl = Astro.site ? new URL(basePath, Astro.site).toString() : new URL(basePath, Astro.url).toString();
const englishPath = basePath === '/' ? '/en/' : `/en${basePath}`;
const englishUrl = Astro.site ? new URL(englishPath, Astro.site).toString() : new URL(englishPath, Astro.url).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // First visit with an English browser: offer the English site. Runs before paint so the
      // Spanish page never flashes. Crawlers and automation are left on the requested URL so
      // search engines index both languages.
      try {
        const isBot = navigator.webdriver || /bot|crawl|spider|slurp|lighthouse|headless/i.test(navigator.userAgent);
        const chosen = localStorage.getItem('nexa-language');
        if (!isBot && !chosen && navigator.language?.toLowerCase().startsWith('en') && !location.pathname.startsWith('/en')) {
          localStorage.setItem('nexa-language', 'en');
          location.replace(`/en${location.pathname}${location.hash}`);
        }
      } catch {}
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#201F1C" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Nexa Digital Agency" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={spanishUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={spanishUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nexa Digital Agency" />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'es_ES'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Nexa Digital Agency',
      description,
      url: canonical,
      logo: new URL('/nexa-logo.svg', Astro.site ?? Astro.url).toString(),
      email: 'hola@nexa.agency',
      areaServed: 'ES',
      knowsAbout,
    })} />
    <title>{title}</title>
    <script is:inline>
      // Before first paint (see site-transitions.ts):
      // - intro-pending keeps the hero hidden until its entrance plays, so it is never shown and then re-hidden.
      // - is-loading shows the logo loader on the first visit of the session.
      try {
        const root = document.documentElement;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('intro-pending');
          if (!sessionStorage.getItem('nexa-intro')) root.classList.add('is-loading');
          // Safety net only for when the site script never runs: the script cancels it as soon as it starts.
          window.__nexaSafety = setTimeout(() => root.classList.remove('is-loading', 'intro-pending'), 8000);
        }
      } catch {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,500..800&family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body id="top" data-label={lang === 'en' ? 'Home' : 'Inicio'}>
    <div class="site-loader" aria-hidden="true">
      <div class="site-loader-logo"><NexaLogo /></div>
    </div>
    <div class="page-curtain" aria-hidden="true">
      <span class="page-curtain-mask"><span class="page-curtain-label" data-curtain-label></span></span>
      <div class="page-curtain-logo"><NexaLogo /></div>
    </div>
    <a class="skip-link" href="#main">{lang === 'en' ? 'Skip to content' : 'Saltar al contenido'}</a>
    <slot />
    <script>
      import '../scripts/site-transitions';
    </script>
    <script is:inline>
      const headers = [...document.querySelectorAll('.site-header')];
      let previousY = window.scrollY;
      let previousTime = performance.now();
      let scrollStopTimer;
      const updateHeaderSurface = () => {
        const now = performance.now();
        const currentY = window.scrollY;
        const distance = Math.abs(currentY - previousY);
        const elapsed = Math.max(now - previousTime, 1);
        const velocity = distance / elapsed;
        const returnDuration = Math.round(Math.max(220, Math.min(520, 520 - velocity * 140)));
        headers.forEach((header) => {
          header.classList.toggle('is-scrolled', currentY > 16);
          header.style.setProperty('--header-return-duration', `${returnDuration}ms`);
          if (currentY > 16 && !header.classList.contains('menu-open')) header.classList.add('is-moving');
        });
        window.clearTimeout(scrollStopTimer);
        const idleDelay = Math.round(Math.max(110, Math.min(240, 110 + velocity * 45)));
        scrollStopTimer = window.setTimeout(() => {
          headers.forEach((header) => header.classList.remove('is-moving'));
        }, idleDelay);
        if (currentY <= 16) headers.forEach((header) => header.classList.remove('is-moving'));
        previousY = currentY;
        previousTime = now;
      };
      headers.forEach((header) => header.classList.toggle('is-scrolled', window.scrollY > 16));
      window.addEventListener('scroll', updateHeaderSurface, { passive: true });
      const setMenu = (header, open) => {
        const button = header.querySelector('.menu-toggle');
        header.classList.toggle('menu-open', open);
        document.body.classList.toggle('menu-active', open);
        button?.setAttribute('aria-expanded', String(open));
        button?.setAttribute('aria-label', (open ? button.dataset.labelClose : button.dataset.labelOpen) ?? '');
      };
      document.querySelectorAll('.menu-toggle').forEach((button) => {
        button.addEventListener('click', () => {
          const header = button.closest('.site-header');
          if (header) setMenu(header, !header.classList.contains('menu-open'));
        });
      });
      document.querySelectorAll('.mobile-menu a').forEach((link) => {
        link.addEventListener('click', () => {
          const header = link.closest('.site-header');
          if (header) setMenu(header, false);
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        document.querySelectorAll('.site-header.menu-open').forEach((header) => {
          setMenu(header, false);
          header.querySelector('.menu-toggle')?.focus();
        });
      });
    </script>
  </body>
</html>
