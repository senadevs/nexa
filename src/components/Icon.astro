---
export type IconName = 'arrow-up-right' | 'arrow-down' | 'arrow-up' | 'pause' | 'play';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = '' } = Astro.props;
const paths: Record<IconName, string> = {
  'arrow-up-right': 'M7 17 17 7M8 7h9v9',
  'arrow-down': 'M12 5v14M6 13l6 6 6-6',
  'arrow-up': 'M12 19V5M6 11l6-6 6 6',
  pause: 'M9 5v14M15 5v14',
  play: 'M8 5.5v13l10.5-6.5z',
};
---

<svg class:list={["icon", `icon-${name}`, className]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d={paths[name]} />
</svg>
