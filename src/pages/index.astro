---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout>
  <header class="site-header" data-header>
    <a class="wordmark" href="#home" aria-label="Nexa, inicio"><span>N</span>exa<i>.</i></a>
    <nav aria-label="Navegación principal">
      <a href="#clientes">Clientes</a><a href="#servicios">Servicios</a><a href="/trabajos">Trabajo</a><a href="#contacto">Contactos</a>
    </nav>
    <a class="header-cta" href="#contacto">Hablemos <span>↗</span></a>
  </header>

  <main>
    <section class="hero hero-full" id="home" aria-labelledby="hero-title">
      <div class="hero-media-stage" aria-hidden="true"><video class="hero-video is-active" data-media="0" autoplay muted loop playsinline preload="metadata"><source src="/nexa-showreel.mp4" type="video/mp4" /></video><img data-media="1" src="/images/hero-ribbon.png" alt="" /><img data-media="2" src="/images/hero-planes.png" alt="" /></div>
      <div class="hero-shade"></div>
      <div class="hero-content reveal"><div class="hero-slide" data-slide="0"><h1 id="hero-title">Ideas que<br /><em>mueven.</em></h1><p>Construimos marcas con estrategia, creatividad y la energía necesaria para dejar huella.</p></div><div class="hero-slide" data-slide="1" hidden><h1>Marcas con<br /><em>criterio.</em></h1><p>De la primera intuición a la última pantalla: damos forma a lo que tu marca quiere decir.</p></div><div class="hero-slide" data-slide="2" hidden><h1>Hacemos que<br /><em>pase.</em></h1><p>Ideas que se sienten, se comparten y convierten atención en movimiento.</p></div><a class="hero-link" href="#servicios">Descubre cómo trabajamos <span>↓</span></a></div><div class="hero-progress" aria-hidden="true"><span class="is-active"></span><span></span><span></span></div>
    </section>

    <div class="ticker" aria-label="Áreas de trabajo"><div>Branding <b>✳</b> Digital <b>✳</b> Content <b>✳</b> Paid Media <b>✳</b> Branding <b>✳</b> Digital <b>✳</b></div></div>

    <section class="intro section-grid spatial-section" id="nosotros" aria-labelledby="intro-title" data-spatial="left">
      <p class="section-label">01 / La idea</p>
      <div class="intro-body reveal"><h2 id="intro-title">Lo que importa no es<br /><span>estar.</span> Es <em>dejar huella.</em></h2><p>Nos implicamos de verdad. Entendemos tu negocio, encontramos la tensión y la convertimos en una idea capaz de hacer que la gente pare, mire y recuerde.</p><a class="text-link" href="#contacto">Conoce nuestra forma de trabajar <span>↗</span></a></div>
    </section>

    <section class="immersive-break" aria-labelledby="immersive-title">
      <div class="immersive-stage"><img class="immersive-fallback" src="/images/hero-ribbon.png" alt="" /><canvas id="scroll-canvas" aria-label="Escena 3D interactiva de Nexa"></canvas></div>
      <div class="immersive-copy" id="immersive-title"><article class="immersive-step is-active"><span>01</span><h2>Una idea<br /><em>aparece.</em></h2><p>Partimos de una tensión, una pregunta o una oportunidad.</p></article><article class="immersive-step"><span>02</span><h2>La forma<br /><em>cambia.</em></h2><p>Probamos, mezclamos y damos estructura a lo que todavía no existe.</p></article><article class="immersive-step"><span>03</span><h2>La marca<br /><em>avanza.</em></h2><p>Convertimos la idea en una experiencia que se mueve con la gente.</p></article></div>
    </section>

    <section class="services section-grid spatial-section" id="servicios" aria-labelledby="services-title" data-spatial="right">
      <div class="section-top"><p class="section-label">02 / Lo que hacemos</p><p class="section-aside">Un equipo pequeño.<br />Una mirada grande.</p></div>
      <div class="service-content"><h2 id="services-title" class="sr-only">Servicios</h2><div class="service-list service-accordion">
        <details class="service-card" open><summary><span>01</span><strong>Diseño gráfico</strong><i>+</i></summary><div class="service-detail"><div><p>Convertimos ideas complejas en sistemas visuales claros, reconocibles y llenos de intención.</p><a href="#contacto">Hablemos de tu proyecto ↗</a></div><img src="/images/graphic.png" alt="Dirección visual y composición editorial" loading="lazy" /></div></details>
        <details class="service-card"><summary><span>02</span><strong>Branding</strong><i>+</i></summary><div class="service-detail"><div><p>Definimos la voz, el lenguaje y la presencia que hacen que una marca se reconozca antes de ser nombrada.</p><a href="#contacto">Hablemos de tu proyecto ↗</a></div><img src="/images/branding.png" alt="Materiales de identidad visual y branding" loading="lazy" /></div></details>
        <details class="service-card"><summary><span>03</span><strong>Estrategia <em>&amp;</em> creatividad digital</strong><i>+</i></summary><div class="service-detail"><div><p>Encontramos la idea que conecta el objetivo de negocio con una conversación cultural relevante.</p><a href="#contacto">Hablemos de tu proyecto ↗</a></div><img src="/images/strategy.png" alt="Dirección creativa para una experiencia digital" loading="lazy" /></div></details>
        <details class="service-card"><summary><span>04</span><strong>Paid media</strong><i>+</i></summary><div class="service-detail"><div><p>Planificamos, lanzamos y optimizamos campañas para que la inversión se convierta en aprendizaje y crecimiento.</p><a href="#contacto">Hablemos de tu proyecto ↗</a></div><img src="/images/paid-media.png" alt="Planificación visual de una campaña" loading="lazy" /></div></details>
        <details class="service-card"><summary><span>05</span><strong>Diseño web</strong><i>+</i></summary><div class="service-detail"><div><p>Diseñamos webs rápidas, memorables y preparadas para convertir visitas en oportunidades.</p><a href="/trabajos">Ver nuestro trabajo ↗</a></div><img src="/images/web.png" alt="Dirección de una experiencia web digital" loading="lazy" /></div></details>
        <details class="service-card"><summary><span>06</span><strong>Producción audiovisual</strong><i>+</i></summary><div class="service-detail"><div><p>Del concepto al montaje final: damos movimiento a la historia que tu marca necesita contar.</p><a href="#contacto">Hablemos de tu proyecto ↗</a></div><img src="/images/audiovisual.png" alt="Dirección de arte para producción audiovisual" loading="lazy" /></div></details>
      </div></div>
    </section>

    <section class="work-preview section-grid spatial-section" aria-labelledby="work-title" data-spatial="depth"><div class="section-top"><p class="section-label">03 / Trabajo seleccionado</p><p class="section-aside">Ideas que pasan<br />de la pantalla al mundo.</p></div><div class="work-body"><h2 id="work-title">El trabajo<br /><em>habla.</em></h2><a class="work-card" href="/trabajos"><video autoplay muted loop playsinline preload="metadata" aria-label="Selección de trabajos de Nexa"><source src="/nexa-showreel.mp4" type="video/mp4" /></video><div><span>Ver proyectos</span><b>↗</b></div></a></div></section>

    <section class="clients section-grid spatial-section" id="clientes" aria-labelledby="clients-title" data-spatial="diagonal">
      <div class="section-top"><p class="section-label">04 / En buena compañía</p><p class="section-aside">Cada proyecto es una<br />conversación distinta.</p></div>
      <div class="client-content"><h2 id="clients-title">Marcas que<br /><em>confían.</em></h2><div class="client-logos" aria-label="Clientes de Nexa"><span>marea</span><span class="serif">norte</span><span>ORBITA</span><span class="serif italic">estudio 44</span><span>croma<span class="lime">.</span></span><span class="serif">lumen</span></div></div>
    </section>

    <section class="contact spatial-section" id="contacto" aria-labelledby="contact-title" data-spatial="up"><p class="section-label">05 / Hablemos</p><div class="contact-inner"><h2 id="contact-title">¿Tienes algo<br /><em>en mente?</em></h2><a class="contact-arrow" href="mailto:hola@nexa.agency" aria-label="Escribir a Nexa">→</a></div><div class="contact-footer"><a href="mailto:hola@nexa.agency">hola@nexa.agency</a><span>Madrid / España</span><a href="https://instagram.com" target="_blank" rel="noreferrer">Instagram ↗</a></div></section>
  </main>
  <footer><a class="wordmark" href="#home"><span>N</span>exa<i>.</i></a><p>Marketing con intención.</p><p>© Nexa 2026</p></footer>

  <script>
    import '../scripts/scroll-scene';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    const slides = [...document.querySelectorAll<HTMLElement>('[data-slide]')];
    const progress = [...document.querySelectorAll<HTMLElement>('.hero-progress span')];
    const media = [...document.querySelectorAll<HTMLElement>('[data-media]')];
    let slideIndex = 0;
    const showSlide = (next: number) => { slides.forEach((slide, index) => { slide.hidden = index !== next; }); media.forEach((item) => item.classList.toggle('is-active', item.dataset.media === String(next))); progress.forEach((item, index) => item.classList.toggle('is-active', index === next)); slideIndex = next; };
    if (slides.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) window.setInterval(() => showSlide((slideIndex + 1) % slides.length), 5200);
    gsap.registerPlugin(ScrollTrigger);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion) {
      document.fonts.ready.then(() => {
        gsap.utils.toArray<HTMLElement>('.reveal').forEach((element) => {
          gsap.fromTo(element, { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: 0.7, ease: 'power2.out', scrollTrigger: { trigger: element, start: 'top 88%', once: true } });
        });
        gsap.fromTo('.ticker div', { xPercent: 0 }, { xPercent: -18, ease: 'none', scrollTrigger: { trigger: '.ticker', start: 'top bottom', end: 'bottom top', scrub: 1 } });
        const spatialDirections = {
          left: { x: -80, y: 28, rotate: -1.6 },
          right: { x: 80, y: 22, rotate: 1.6 },
          depth: { x: 0, y: 42, scale: 0.94, rotateX: 3 },
          diagonal: { x: -56, y: 34, rotate: 1.2 },
          up: { x: 0, y: 70, scale: 0.96, rotate: -0.8 },
        };
        gsap.utils.toArray<HTMLElement>('[data-spatial]').forEach((section) => {
          const direction = section.dataset.spatial as keyof typeof spatialDirections;
          const from = spatialDirections[direction];
          gsap.fromTo(section, { ...from, transformPerspective: 1200 }, { x: 0, y: 0, scale: 1, rotate: 0, rotateX: 0, ease: 'none', scrollTrigger: { trigger: section, start: 'top 96%', end: 'top 34%', scrub: 1.1 } });
        });
      });
    }
  </script>
</BaseLayout>
