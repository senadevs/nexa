---
interface Props {
  title?: string;
  description?: string;
  lang?: 'es' | 'en';
  ogImage?: string;
}

const {
  title = 'Nexa — Agencia de marketing digital',
  description = 'Estrategia, diseño y contenido para marcas que quieren avanzar.',
  lang = 'es',
  ogImage = '/images/marea-case.png',
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();
const basePath = Astro.url.pathname.startsWith('/en') ? Astro.url.pathname.replace(/^\/en/, '') || '/' : Astro.url.pathname;
const spanishUrl = Astro.site ? new URL(basePath, Astro.site).toString() : new URL(basePath, Astro.url).toString();
const englishPath = basePath === '/' ? '/en/' : `/en${basePath}`;
const englishUrl = Astro.site ? new URL(englishPath, Astro.site).toString() : new URL(englishPath, Astro.url).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#201F1C" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Nexa Digital Agency" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={spanishUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={spanishUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nexa Digital Agency" />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'es_ES'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? Astro.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? Astro.url).toString()} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Nexa',
      description,
      url: canonical,
      inLanguage: lang,
      email: 'hola@nexa.agency',
      areaServed: 'ES',
      knowsAbout: ['Branding', 'Marketing digital', 'Diseño web', 'Paid media', 'Producción audiovisual'],
    })} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,500..800&family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='50' fill='%23FF5E1E'/%3E%3Ctext x='50' y='67' text-anchor='middle' font-size='60' font-family='Arial'%3EN%3C/text%3E%3C/svg%3E" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{lang === 'en' ? 'Skip to content' : 'Saltar al contenido'}</a>
    <slot />
    <script is:inline>
      const browserLanguage = navigator.language?.toLowerCase() ?? '';
      const hasChosenLanguage = localStorage.getItem('nexa-language');
      const isEnglishBrowser = browserLanguage.startsWith('en');
      const isEnglishPage = location.pathname.startsWith('/en');
      if (!hasChosenLanguage && isEnglishBrowser && !isEnglishPage) {
        localStorage.setItem('nexa-language', 'en');
        location.replace(`/en${location.pathname === '/' ? '/' : location.pathname}`);
      }
      const headers = [...document.querySelectorAll('.site-header')];
      let previousY = window.scrollY;
      let previousTime = performance.now();
      let scrollStopTimer;
      const updateHeaderSurface = () => {
        const now = performance.now();
        const currentY = window.scrollY;
        const distance = Math.abs(currentY - previousY);
        const elapsed = Math.max(now - previousTime, 1);
        const velocity = distance / elapsed;
        const returnDuration = Math.round(Math.max(220, Math.min(520, 520 - velocity * 140)));
        headers.forEach((header) => {
          header.classList.toggle('is-scrolled', currentY > 16);
          header.style.setProperty('--header-return-duration', `${returnDuration}ms`);
          if (currentY > 16 && !header.classList.contains('menu-open')) header.classList.add('is-moving');
        });
        window.clearTimeout(scrollStopTimer);
        const idleDelay = Math.round(Math.max(110, Math.min(240, 110 + velocity * 45)));
        scrollStopTimer = window.setTimeout(() => {
          headers.forEach((header) => header.classList.remove('is-moving'));
        }, idleDelay);
        if (currentY <= 16) headers.forEach((header) => header.classList.remove('is-moving'));
        previousY = currentY;
        previousTime = now;
      };
      headers.forEach((header) => header.classList.toggle('is-scrolled', window.scrollY > 16));
      window.addEventListener('scroll', updateHeaderSurface, { passive: true });
      document.querySelectorAll('.menu-toggle').forEach((button) => {
        button.addEventListener('click', () => {
          const header = button.closest('.site-header');
          const open = !header?.classList.contains('menu-open');
          header?.classList.toggle('menu-open', open);
          document.body.classList.toggle('menu-active', open);
          button.setAttribute('aria-expanded', String(open));
        });
      });
      document.querySelectorAll('.mobile-menu a').forEach((link) => {
        link.addEventListener('click', () => {
          const header = link.closest('.site-header');
          header?.classList.remove('menu-open');
          document.body.classList.remove('menu-active');
          header?.querySelector('.menu-toggle')?.setAttribute('aria-expanded', 'false');
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        document.querySelectorAll('.site-header.menu-open').forEach((header) => {
          header.classList.remove('menu-open');
          header.querySelector('.menu-toggle')?.setAttribute('aria-expanded', 'false');
        });
        document.body.classList.remove('menu-active');
      });
    </script>
  </body>
</html>
