---
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { homeCopy, site, type Lang } from '../../i18n/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = homeCopy[lang];
const s = site[lang];
const pad = (n: number) => String(n).padStart(2, '0');
// Puzzle layout: each tile has its own span per breakpoint (see .client-bento in home.css).
const clientLogos = [
  { name: 'marea', style: 'sans', tone: 'ink' },
  { name: 'norte', style: 'serif', tone: 'sand' },
  { name: 'ORBITA', style: 'wide', tone: 'orange' },
  { name: 'estudio 44', style: 'serif italic', tone: 'line' },
  { name: 'croma', style: 'sans dot', tone: 'graphite' },
  { name: 'lumen', style: 'serif', tone: 'line' },
];
const manifestoWords = t.manifesto.text.split(' ');
---

<SiteHeader lang={lang} surface="dark" />

<main id="main">
  <section class="hero" id="home" aria-labelledby="hero-title" data-hero-slides>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-inner">
      <h1 class="hero-title" id="hero-title">
        <span class="line"><span class="line-inner">{t.hero.lineOne}</span></span>
        <span class="line">
          <span class="line-inner rotator" aria-hidden="true">
            {t.hero.slides.map((slide, index) => <span class:list={['rotator-word', { 'is-active': index === 0 }]}>{slide.word}</span>)}
          </span>
          <span class="sr-only">{t.hero.slides[0].word}</span>
        </span>
      </h1>
      <div class="hero-bottom">
        <p class="lead hero-lead">{t.hero.lead}</p>
        <div class="hero-actions">
          <Button label={t.hero.primary} href={`#${s.anchors.contact}`} size="lg" icon="arrow-up-right" />
          <Button label={t.hero.secondary} href={`#${s.anchors.work}`} variant="ghost" size="lg" />
        </div>
      </div>
      <div class="hero-showcase">
        <div class="hero-slides" aria-hidden="true">
          {t.hero.slides.map((slide, index) => (
            <figure class:list={['hero-slide', { 'is-active': index === 0 }]}>
              <picture>
                <source media="(min-width: 801px)" srcset={`/images/hero/${slide.image}-portrait-820.webp`} width="820" height="1025" />
                <img
                  src={`/images/hero/${slide.image}-1280.webp`}
                  srcset={`/images/hero/${slide.image}-720.webp 720w, /images/hero/${slide.image}-1280.webp 1280w`}
                  sizes="92vw"
                  alt=""
                  width="1280"
                  height="800"
                  decoding="async"
                  fetchpriority={index === 0 ? 'high' : undefined}
                />
              </picture>
              <figcaption class="hero-slide-caption">
                <strong>{slide.caption}</strong>
                <span>{slide.detail}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="hero-slide-meta">
          <p class="hero-counter" aria-hidden="true"><b data-hero-counter>01</b><span>/ {pad(t.hero.slides.length)}</span></p>
          <div class="hero-progress" aria-hidden="true">
            {t.hero.slides.map((_, index) => <span class:list={{ 'is-done': index === 0 }}><i></i></span>)}
          </div>
          <button class="hero-toggle" type="button" aria-label={t.hero.pause} data-label-pause={t.hero.pause} data-label-play={t.hero.play} hidden>
            <Icon name="pause" class="icon-when-playing" />
            <Icon name="play" class="icon-when-paused" />
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Decorative: the services are listed as real content further down. -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-band marquee-band-orange">
      <div class="marquee-track" data-marquee="1">
        {[0, 1].map(() => (
          <div class="marquee-group">
            {t.marquee.map((item) => (
              <span class="marquee-item">
                {item}
                <svg class="marquee-star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0l2.6 8.4L23 6l-6.2 6L23 18l-8.4-2.4L12 24l-2.6-8.4L1 18l6.2-6L1 6l8.4 2.4z" /></svg>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
    <div class="marquee-band marquee-band-ink" aria-hidden="true">
      <div class="marquee-track" data-marquee="-1">
        {[0, 1].map(() => (
          <div class="marquee-group">
            {t.marquee.map((item) => (
              <span class="marquee-item marquee-item-outline">
                {item}
                <svg class="marquee-star" viewBox="0 0 24 24"><path d="M12 0l2.6 8.4L23 6l-6.2 6L23 18l-8.4-2.4L12 24l-2.6-8.4L1 18l6.2-6L1 6l8.4 2.4z" /></svg>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <section class="section manifesto" id="nosotros" aria-labelledby="manifesto-title">
    <div class="container">
      <h2 class="manifesto-text" id="manifesto-title" data-manifesto>
        {manifestoWords.map((word) => <span class:list={['mw', { 'is-accent': t.manifesto.highlights.includes(word) }]}>{word} </span>)}
      </h2>
      <div class="manifesto-foot">
        <ul class="stats" role="list">
          {t.manifesto.stats.map((stat) => (
            <li class="stat">
              <strong class="stat-value"><span data-count={stat.value}>{stat.value}</span>{stat.suffix}</strong>
              <span class="stat-label">{stat.label}</span>
            </li>
          ))}
        </ul>
        <Button label={t.manifesto.link} href={`#${s.anchors.process}`} variant="outline" icon="arrow-down" />
      </div>
    </div>
  </section>

  <section class="section clients" id={s.anchors.clients} data-label={s.nav.clients} aria-labelledby="clients-title">
    <div class="container">
      <h2 class="display-title clients-title" id="clients-title" data-reveal-title>{t.clients.title} <em>{t.clients.titleAccent}</em></h2>
      <ul class="client-bento" role="list">
        {clientLogos.map((logo, index) => (
          <li class:list={['client-tile', `tile-${index + 1}`, logo.style]} data-tone={logo.tone}>
            <span class="client-name">{logo.name}</span>
          </li>
        ))}
        <li class="client-tile tile-7 tile-quote" data-tone="ink">
          <p>{t.clients.aside}</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section services sheet sheet-ink" id={s.anchors.services} data-label={s.nav.services} aria-labelledby="services-title">
    <div class="container">
      <div class="split-title">
        <h2 class="display-title" id="services-title" data-reveal-title>{t.services.title} <em>{t.services.titleAccent}</em></h2>
        <p class="aside">{t.services.aside}</p>
      </div>
      <div class="service-stack">
        {t.services.items.map((item, index) => (
          <article class="service-card" data-tone={item.tone} style={`--i:${index}`} aria-labelledby={`service-${index}`}>
            <div class="service-card-inner">
              <span class="service-dim" aria-hidden="true"></span>
              <div class="service-top">
                <span class="service-number">{pad(index + 1)}</span>
                <ul class="tags" role="list" aria-label={item.title}>
                  {item.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
              <h3 class="service-title" id={`service-${index}`}>{item.title}</h3>
              <div class="service-body">
                <div class="service-copy">
                  <p>{item.text}</p>
                  <a class="text-link" href={`#${s.anchors.contact}`} data-service={item.service}>{item.cta}<Icon name="arrow-up-right" /></a>
                </div>
                <figure class="service-media">
                  <img
                    src={`/images/services/${item.image}-1200.webp`}
                    srcset={`/images/services/${item.image}-800.webp 800w, /images/services/${item.image}-1200.webp 1200w`}
                    sizes="(min-width: 801px) 55vw, 90vw"
                    alt={item.alt}
                    width="1200"
                    height="800"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section work sheet sheet-paper" id={s.anchors.work} data-label={s.nav.work} aria-labelledby="work-title">
    <div class="work-pin">
      <div class="container work-header">
        <div class="split-title">
          <h2 class="display-title" id="work-title" data-reveal-title>{t.work.title} <em>{t.work.titleAccent}</em></h2>
          <div class="work-intro">
            <p class="aside">{t.work.intro}</p>
            <a class="text-link" href={s.workPage}>{t.work.all}<Icon name="arrow-up-right" /></a>
          </div>
        </div>
      </div>
      <div class="work-viewport">
        <ul class="work-track" role="list">
          {t.work.items.map((item) => (
            <li class="work-item">
              <a class="work-card" href={s.workPage}>
                <span class="work-arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
                <figure class="work-media">
                  <img
                    src={`/images/work/${item.image}-1400.webp`}
                    srcset={`/images/work/${item.image}-800.webp 800w, /images/work/${item.image}-1400.webp 1400w`}
                    sizes="(min-width: 1025px) 62vw, 84vw"
                    alt={item.alt}
                    width="1400"
                    height="1050"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
                <div class="work-info">
                  <span class="work-category">{item.category}</span>
                  <h3 class="work-name">{item.name}</h3>
                  <p>{item.result}</p>
                </div>
              </a>
            </li>
          ))}
          <li class="work-item">
            <a class="work-card work-card-next" href={`#${s.anchors.contact}`}>
              <strong class="work-next-title">{t.work.next.title}<br /><em>{t.work.next.accent}</em></strong>
              <Button label={t.work.next.cta} as="span" variant="dark" size="lg" icon="arrow-up-right" />
            </a>
          </li>
        </ul>
        <div class="work-progress" aria-hidden="true"><span></span></div>
      </div>
    </div>
  </section>

  <section class="section process immersive-break sheet sheet-ink" id={s.anchors.process} data-label={t.process.label} aria-labelledby="process-title">
    <h2 class="sr-only" id="process-title">{t.process.label}</h2>
    <div class="process-grid">
      <div class="immersive-copy">
        {t.process.steps.map((step, index) => (
          <article class:list={['immersive-step', { 'is-active': index === 0 }]}>
            <span class="step-number">{pad(index + 1)}</span>
            <h3>{step.title}<br /><em>{step.accent}</em></h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
      <div class="immersive-stage">
        <img class="immersive-fallback" src="/images/services/branding-800.webp" alt="" width="800" height="533" loading="lazy" decoding="async" />
        <canvas id="scroll-canvas" aria-hidden="true"></canvas>
      </div>
    </div>
  </section>

  <section class="section contact sheet sheet-orange" id={s.anchors.contact} data-label={s.nav.contact} aria-labelledby="contact-title">
    <div class="container">
      <h2 class="contact-title" id="contact-title" data-reveal-title>{t.contact.title} <em>{t.contact.titleAccent}</em></h2>
      <div class="contact-grid">
        <div class="contact-aside">
          <p class="lead">{t.contact.intro}</p>
          <ul class="contact-channels" role="list">
            {t.contact.channels.map((channel) => (
              <li>
                <small>{channel.label}</small>
                {channel.href ? (
                  <a href={channel.href} target={channel.href.startsWith('http') ? '_blank' : undefined} rel={channel.href.startsWith('http') ? 'noreferrer' : undefined}>
                    {channel.value}<Icon name="arrow-up-right" />
                  </a>
                ) : (
                  <span>{channel.value}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
        <form class="contact-form" id="contact-form" novalidate data-subject={t.contact.form.subject} data-sent={t.contact.form.sent} data-required={t.contact.form.required} data-invalid-email={t.contact.form.invalidEmail}>
          <div class="form-field">
            <label for="name">{t.contact.form.name}</label>
            <input id="name" name="name" type="text" autocomplete="name" required aria-describedby="name-error" />
            <p class="field-error" id="name-error" hidden></p>
          </div>
          <div class="form-field">
            <label for="email">{t.contact.form.email}</label>
            <input id="email" name="email" type="email" autocomplete="email" required aria-describedby="email-error" />
            <p class="field-error" id="email-error" hidden></p>
          </div>
          <div class="form-field">
            <label for="company">{t.contact.form.company}</label>
            <input id="company" name="company" type="text" autocomplete="organization" />
          </div>
          <div class="form-field">
            <label for="service">{t.contact.form.service}</label>
            <select id="service" name="service">
              <option value="">{t.contact.form.servicePlaceholder}</option>
              {t.contact.form.services.map((service) => <option>{service}</option>)}
            </select>
          </div>
          <div class="form-field form-field-wide">
            <label for="message">{t.contact.form.message}</label>
            <textarea id="message" name="message" rows="4" required aria-describedby="message-error"></textarea>
            <p class="field-error" id="message-error" hidden></p>
          </div>
          <div class="form-actions">
            <Button label={t.contact.form.submit} type="submit" size="lg" icon="arrow-up-right" />
            <p class="form-note" id="form-note" aria-live="polite">{t.contact.form.note}</p>
          </div>
        </form>
      </div>
    </div>
  </section>
</main>

<SiteFooter lang={lang} />


<script>
  import '../../scripts/scroll-scene';
  import '../../scripts/home-motion';
  import '../../scripts/hero-slides';

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const serviceSelect = form?.querySelector<HTMLSelectElement>('#service');

  // Service CTAs preselect their service in the contact form.
  document.querySelectorAll<HTMLAnchorElement>('[data-service]').forEach((link) => {
    link.addEventListener('click', () => {
      if (serviceSelect && link.dataset.service) serviceSelect.value = link.dataset.service;
    });
  });

  const fieldError = (field: HTMLInputElement | HTMLTextAreaElement) => {
    if (field.validity.valueMissing) return form?.dataset.required ?? '';
    if (field.validity.typeMismatch) return form?.dataset.invalidEmail ?? '';
    return '';
  };
  const showError = (field: HTMLInputElement | HTMLTextAreaElement) => {
    const message = fieldError(field);
    const output = document.getElementById(`${field.id}-error`);
    field.setAttribute('aria-invalid', String(Boolean(message)));
    if (output) {
      output.textContent = message;
      output.hidden = !message;
    }
    return !message;
  };
  const requiredFields = [...(form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]') ?? [])];
  requiredFields.forEach((field) => field.addEventListener('input', () => field.getAttribute('aria-invalid') === 'true' && showError(field)));

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const invalid = requiredFields.filter((field) => !showError(field));
    if (invalid.length) {
      invalid[0].focus();
      return;
    }
    const target = event.currentTarget as HTMLFormElement;
    const data = new FormData(target);
    const subject = `${target.dataset.subject} — ${data.get('company') || data.get('name')}`;
    const body = [`Nombre / Name: ${data.get('name')}`, `Email: ${data.get('email')}`, `Empresa / Company: ${data.get('company') || '—'}`, `Servicio / Service: ${data.get('service') || '—'}`, '', `${data.get('message')}`].join('\n');
    window.location.href = `mailto:hola@nexa.agency?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    const note = document.querySelector<HTMLElement>('#form-note');
    if (note && target.dataset.sent) note.textContent = target.dataset.sent;
  });
</script>
